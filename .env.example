# Supabase → Project Settings → API Keys (and the Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Server only (never NEXT_PUBLIC_). Used by the API routes to create listings, upload photos and save messages.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional: email the seller when a message arrives (Gmail app password, see README)
GMAIL_USER=you@gmail.com
